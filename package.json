{
  "name": "@m-one-dev/awesome-nest-oxlint",
  "version": "1.0.0",
  "description": "Opinionated oxlint plugin with NestJS-aware rules used across m-one projects. Its type-aware rules get type information from tsrs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-one-dev/awesome-nest-oxlint.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:prod": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "nestjs",
    "typeorm",
    "m-one"
  ],
  "dependencies": {
    "@typescript-eslint/types": "^8.63.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.93.0",
    "tsrs": "0.24.0-ts7.1.0-beta"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/utils": "^8.56.0",
    "oxlint": "1.93.0",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.33.2"
}
